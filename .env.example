# Copy to .env.local for local dev; set the same keys in the Vercel dashboard.

# Base URL of the BunPho API (Render service). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this site — used to build the QR-code links in the admin panel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth Web client ID (same value as the backend's GOOGLE_CLIENT_ID).
# Leave empty to hide the "Sign in with Google" button on the admin login page.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
